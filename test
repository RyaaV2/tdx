local function GetLiveTDSLevel()
    local function readNumber(obj)
        local value = nil

        pcall(function()
            value = obj.ContentText
        end)

        if value == nil or tostring(value) == "" then
            pcall(function()
                value = obj.Text
            end)
        end

        if value == nil or tostring(value) == "" then
            pcall(function()
                value = obj.Value
            end)
        end

        local text = tostring(value or "")
        local number = tonumber(text:match("%d+"))

        if number and number >= 0 and number <= 1000 then
            return number
        end

        return nil
    end

    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        local name = obj.Name:lower()

        if name == "currentlevel" or name == "playerlevel" then
            local level = readNumber(obj)

            if level then
                return level
            end
        end
    end

    local roots = {
        PlayerGui:FindFirstChild("ReactLobbyHud"),
        PlayerGui:FindFirstChild("ReactUniversalHotbar"),
        PlayerGui:FindFirstChild("ReactGameNewRewards")
    }

    for _, root in ipairs(roots) do
        if root then
            for _, obj in ipairs(root:GetDescendants()) do
                if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                    local text = ""

                    pcall(function()
                        text = obj.ContentText or obj.Text or ""
                    end)

                    local level = tonumber(
                        tostring(text):match("[Ll]evel%s*[:%-]?%s*(%d+)")
                    )

                    if level and level >= 0 and level <= 1000 then
                        return level
                    end
                end
            end
        end
    end

    return nil
end

local function GetBestProgressionLevel()
    if game.PlaceId == LOBBY_PLACE_ID then
        local statLevel = GetStat("Level")

        if statLevel ~= nil and statLevel >= 0 then
            Settings.ProgressInitialized = true
            Settings.SavedLevel = statLevel
            Settings.InGameLevel = statLevel
            SaveSettings()
            return statLevel
        end
    end

    local liveLevel = GetLiveTDSLevel()

    if liveLevel ~= nil and liveLevel >= 0 then
        Settings.ProgressInitialized = true
        Settings.SavedLevel = liveLevel
        Settings.InGameLevel = liveLevel
        SaveSettings()
        return liveLevel
    end

    local statLevel = GetStat("Level")

    if statLevel ~= nil and statLevel >= 0 then
        return statLevel
    end

    return tonumber(Settings.SavedLevel) or 0
end


