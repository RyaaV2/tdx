local function CaptureRewardLevel()
    local level = WaitForFinalRewardLevel()

    if level == nil then
        return false
    end

    local changed =
        Settings.SavedLevel ~= level
        or Settings.ProgressInitialized ~= true

    Settings.ProgressInitialized = true
    Settings.SavedLevel = level
    Settings.InGameLevel = level

    ApplyRewardLevelToGui(level)

    if changed then
        SaveSettings()
    end

    return true, level
end

