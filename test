local function DirectPlaceTower(towerName, position)
    while AutoProgression do
        local gameStateReplicator = GetDirectGameStateReplicator()
        local towersFolder = GetDirectTowersFolder()

        if not gameStateReplicator or not towersFolder then
            task.wait(0.05)
            continue
        end

        if gameStateReplicator:GetAttribute("GameOver") == true then
            return false
        end

        local before = DirectGetOwnedTowers()
        local newTower = nil
        local connection

        connection = towersFolder.ChildAdded:Connect(function(tower)
            task.spawn(function()
                local owner = tower:FindFirstChild("Owner") or tower:WaitForChild("Owner", 2)

                if owner and owner.Value == plr.UserId and not newTower then
                    newTower = tower
                end
            end)
        end)

        local ok, err = pcall(function()
            TDS:Place(
                towerName,
                position.X,
                position.Y,
                position.Z,
                true
            )
        end)

        if not ok then
            if connection then
                connection:Disconnect()
            end

            warn("[PLACE] Error:", err)
            task.wait(0.05)
            continue
        end

        local timeoutAt = os.clock() + 2

        repeat
            if gameStateReplicator:GetAttribute("GameOver") == true then
                if connection then
                    connection:Disconnect()
                end

                return false
            end

            if not newTower then
                for _, tower in ipairs(towersFolder:GetChildren()) do
                    if not before[tower] then
                        local owner = tower:FindFirstChild("Owner")

                        if owner and owner.Value == plr.UserId then
                            newTower = tower
                            break
                        end
                    end
                end
            end

            if newTower then
                break
            end

            task.wait(0.01)
        until os.clock() >= timeoutAt

        if connection then
            connection:Disconnect()
        end

        if newTower then
            table.insert(TDS.PlacedTowers, newTower)
            
            return true
        end

        task.wait(0.05)
    end

    return false
end

