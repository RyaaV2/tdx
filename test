local StoryTimeoutToken = 0
local STORY_TIMEOUT = 5 * 60

local function StopStoryTimeout()
    StoryTimeoutToken += 1
end

local function StartStoryTimeout(rep, difficulty)
    StopStoryTimeout()

    local myToken = StoryTimeoutToken
    local storyName = STORY_MISSIONS[difficulty] or tostring(difficulty)

    

    task.spawn(function()
        task.wait(STORY_TIMEOUT)

        if myToken ~= StoryTimeoutToken then
            return
        end

        if not AutoProgression then
            return
        end

        if not rep or not rep.Parent then
            return
        end

        if rep:GetAttribute("GameOver") == true then
            StopStoryTimeout()
            return
        end

        warn(
            "[STORY ANTI STUCK]",
            storyName,
            "did not reach GameOver within 5 minutes. Returning to lobby..."
        )

        statusDisplay.Text =
            "Status: Story Stuck - Returning to Lobby..."

        StopStoryTimeout()
        BackToLobby()
    end)
end

local function RunChapter0Progression()
    if Settings.Chapter0Completed == true then
        return false
    end

    local function clickGuiButton(btn)
        if not btn then
            return false
        end

        local ok = pcall(function()
            if firesignal then
                firesignal(btn.MouseButton1Down)
                firesignal(btn.MouseButton1Up)
                firesignal(btn.MouseButton1Click)
                firesignal(btn.Activated)
            else
                for _, conn in ipairs(getconnections(btn.MouseButton1Down) or {}) do
                    conn:Fire()
                end

                for _, conn in ipairs(getconnections(btn.MouseButton1Up) or {}) do
                    conn:Fire()
                end

                for _, conn in ipairs(getconnections(btn.MouseButton1Click) or {}) do
                    conn:Fire()
                end

                for _, conn in ipairs(getconnections(btn.Activated) or {}) do
                    conn:Fire()
                end
            end
        end)

        return ok
    end

    local function checkSuccess(data)
        if data == true then
            return true
        end

        if type(data) == "table" and data.Success == true then
            return true
        end

        local ok, isModel = pcall(function()
            return data and data:IsA("Model")
        end)

        if ok and isModel then
            return true
        end

        if type(data) == "userdata" then
