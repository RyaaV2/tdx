    end

    task.wait(0.5)

    for _, towerName in ipairs(requested) do
        if towerName
            and towerName ~= ""
            and towerName ~= "None" then

            re:FireServer(
                "Inventory",
                "Equip",
                "Tower",
                towerName
            )
            task.wait(0.3)
        end
    end

    task.wait(0.5)
    return true
