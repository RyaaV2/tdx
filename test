local function BackToLobby()
    if game.PlaceId == LOBBY_PLACE_ID then
        return true
    end

    local network = ReplicatedStorage:FindFirstChild("Network")
    local teleportFolder = network and network:FindFirstChild("Teleport")
    local backToLobby = teleportFolder and teleportFolder:FindFirstChild("RE:backToLobby")

    local remoteWorked = false

    if backToLobby then
        remoteWorked = pcall(function()
            backToLobby:FireServer()
        end)
    end

    if remoteWorked then
        task.wait(5)

        if game.PlaceId == LOBBY_PLACE_ID then
            return true
        end
    end

    warn("[BACK TO LOBBY] Remote failed or did not teleport, using PlaceId fallback")

    local ok = pcall(function()
        TeleportService:Teleport(
            LOBBY_PLACE_ID,
            plr
        )
    end)

    return ok
end

