function TDS:Place(towerName, x, y, z, ...)
    local args = {...}
    local isStacking =
        args[#args] == true
        or args[#args] == "stack"

    local position = Vector3.new(x, y, z)

    if isStacking then
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude

        local ignore = {}
        local towersFolder = workspace:FindFirstChild("Towers")

        if towersFolder then
            table.insert(ignore, towersFolder)
        end

        if plr.Character then
            table.insert(ignore, plr.Character)
        end

        rayParams.FilterDescendantsInstances = ignore

        local hit = workspace:Raycast(
            Vector3.new(x, y + 200, z),
            Vector3.new(0, -1000, 0),
            rayParams
        )

        if not hit then
            warn("[STACKER] No surface found:", towerName, x, y, z)
            return false
        end

        position = Vector3.new(
            x,
            hit.Position.Y + 25,
            z
        )

        return rf:InvokeServer(
            "Troops",
            "Place",
            {
                Rotation = CFrame.new(),
                Position = position
            },
            towerName
        )
    end

    return rf:InvokeServer(
        "Troops",
        "Place",
        {
            Rotation = CFrame.new(),
            Position = position
        },
        towerName,
        ...
    )
end

local function DirectResponseOK(result)
    if result == true then
        return true
    end

    if type(result) == "table" and result.Success == true then
        return true
    end

    local ok, isModel = pcall(function()
        return result and result:IsA("Model")
    end)

    if ok and isModel then
        return true
    end

    if type(result) == "userdata" then
        return true
    end

    return false
end

