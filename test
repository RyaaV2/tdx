local function ReadRewardScreenLevel()
    local currentLevelObj = GetRewardLevelObject()

    if not currentLevelObj then
        return nil
    end

    return TextToNumber(tostring(currentLevelObj.Text or ""))
end

local function WaitForFinalRewardLevel()
    local timeoutAt = os.clock() + 10
    local level

    repeat
        level = ReadRewardScreenLevel()

        if level ~= nil then
            break
        end

        task.wait(0.1)
    until os.clock() >= timeoutAt

    if level == nil then
        return nil
    end

    task.wait(1.5)

    local lastLevel = nil
    local stableReads = 0
    local stableNeeded = 10
    local settleTimeoutAt = os.clock() + 10

    while os.clock() < settleTimeoutAt do
        level = ReadRewardScreenLevel()

        if level ~= nil then
            if level == lastLevel then
                stableReads += 1
            else
                lastLevel = level
                stableReads = 1
            end

            if stableReads >= stableNeeded then
                return level
            end
        end

        task.wait(0.1)
    end

    return lastLevel
end

