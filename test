local function IsOwnedTower(tower)
    local owner = tower:FindFirstChild("Owner")

    if owner and owner.Value == Player.UserId then
        return true
    end

    local rep = tower:FindFirstChild("TowerReplicator")

    return rep
        and rep:GetAttribute("OwnerId") == Player.UserId
end

local function PlaceTower(name, position)
    local folder = workspace:WaitForChild("Towers")
    local existing = {}

    for _, tower in ipairs(folder:GetChildren()) do
        if IsOwnedTower(tower) then
            existing[tower] = true
        end
    end

    while true do
        local ok, result = pcall(function()
            return RemoteFunc:InvokeServer(
                "Troops",
                "Place",
                {
                    Rotation = CFrame.new(),
                    Position = position
                },
                name
            )
        end)

        if ok and CheckResOk(result) then
            break
        end

        task.wait(0.25)
    end

    local newTower

    repeat
        for _, tower in ipairs(folder:GetChildren()) do
            if not existing[tower] and IsOwnedTower(tower) then
                newTower = tower
                break
            end
        end

        task.wait(0.05)
    until newTower

    Towers[#Towers + 1] = newTower
    return #Towers
end

