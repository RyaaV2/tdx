local function StartCommanderAutoClick()
    task.spawn(function()

        local function getCommanderCap()
            local dialog = PlayerGui:FindFirstChild("ReactOverridesDialog")
            local frame = dialog and dialog:FindFirstChild("Frame")
            local character = frame and frame:FindFirstChild("dialogCharacter")
            local worldModel = character and character:FindFirstChild("worldModel")
            local commander = worldModel and worldModel:FindFirstChild("Commander")
            local outfit = commander and commander:FindFirstChild("Outfit")

            return outfit and outfit:FindFirstChild("CommanderCap1")
        end

        local function getDialogListener()
            local dialog = PlayerGui:FindFirstChild("ReactOverridesDialog")
            local frame = dialog and dialog:FindFirstChild("Frame")
            local content = frame and frame:FindFirstChild("content")

            if not content then
                return nil
            end

            local connections = getconnections(content.InputBegan)
            local connection = connections[1]

            if not connection or not connection.Function then
                return nil
            end

            local manager = getupvalues(connection.Function)[1]

            if type(manager) ~= "table"
                or type(manager._listeners) ~= "table" then
                return nil
            end

            for _, listener in pairs(manager._listeners) do
                if type(listener) == "function" then
                    for _, constant in ipairs(getconstants(listener)) do
                        if constant == "MouseButton1" then
                            return listener, content
                        end
                    end
                end
            end

            return nil
        end

        local function clickDialog(listener, content)
            listener(content, {
                UserInputType = Enum.UserInputType.MouseButton1
            })
        end

        while task.wait(0.2) do
            if getCommanderCap() then
                local listener, content = getDialogListener()

                if listener then
                    pcall(function()
                        clickDialog(listener, content)
                    end)
                end
            end
        end

    end)
end

