local function GetTrackedCoins()
    local liveCoins = 0
    local coinsObject = plr:FindFirstChild("Coins")

    if coinsObject and coinsObject.Value ~= nil then
        liveCoins = tonumber(coinsObject.Value) or 0
    end

    if CurrentTrackedCoins > liveCoins then
        return CurrentTrackedCoins
    end

    return liveCoins
end

local function RecordMatchStartCoins()
    local liveCoins = 0
    local coinsObject = plr:FindFirstChild("Coins")

    if coinsObject and coinsObject.Value ~= nil then
        liveCoins = tonumber(coinsObject.Value) or 0
    end

    MatchStartCoins = math.max(liveCoins, CurrentTrackedCoins or 0)
    CurrentTrackedCoins = MatchStartCoins

    
end

local function UpdateTrackedCoinsFromReward()
    local playerReplicator
    local stateReplicators = ReplicatedStorage:FindFirstChild("StateReplicators")

    if stateReplicators then
        for _, replicator in ipairs(stateReplicators:GetChildren()) do
            if replicator.Name == "PlayerReplicator"
                and tonumber(replicator:GetAttribute("UserId")) == plr.UserId then
                playerReplicator = replicator
                break
            end
        end
    end

    local reward = playerReplicator
        and tonumber(playerReplicator:GetAttribute("CoinsReward"))
        or 0

    CurrentTrackedCoins = (tonumber(MatchStartCoins) or 0) + reward

    
    
    

    return CurrentTrackedCoins, reward
end

local function StartMatchTimeout()
    MatchTimeoutToken += 1
    local myToken = MatchTimeoutToken

    RecordMatchStartCoins()

    

    task.spawn(function()
        task.wait(15 * 60)

        if myToken ~= MatchTimeoutToken then
