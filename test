            or attempts >= 10

        if not AutoProgression then
            running = false
            return
        end

        if not saved then
            statusDisplay.Text = "Status: Failed to load level"
            warn("Failed to load lobby level after 10 attempts.")
            running = false
            return
        end

        levelDisplay.Text = string.format(
            "Current Level: %d",
            level
        )

        local targetLevel = GetTargetLevel(level)

        if targetLevel then
            targetDisplay.Text = string.format(
                "Target: Level %d",
                targetLevel
            )
        elseif level >= 175 and AutoProgression then
            targetDisplay.Text = "Target: Gatling Gun"
        else
            targetDisplay.Text = "Target: Completed"
        end

        task.wait(0.5)
    else
        if Settings.Chapter0Completed ~= true then
            local handled = RunChapter0Progression()

            if handled ~= false then
                running = false
                return
            end
        end
    end

    if not AutoProgression then
        running = false
        return
    end

    local level = GetBestProgressionLevel()

    if level >= 0 then
        levelDisplay.Text = string.format(
            "Current Level: %d",
            level
        )

        local targetLevel = GetTargetLevel(level)

        if targetLevel then
            targetDisplay.Text = string.format(
                "Target: Level %d",
                targetLevel
            )
        elseif level >= 175 and AutoProgression then
            targetDisplay.Text = "Target: Gatling Gun"
        else
            targetDisplay.Text = "Target: Completed"
        end
    end

    if IsInGame() then
        local expectedDifficulty = IsWinStrategy() and "Easy" or GetProgressModeName(level)
        local currentDifficulty = GetCurrentDifficulty()

        if AutoMaxMode and level >= 175 then
            expectedDifficulty = currentDifficulty
        end

        if expectedDifficulty ~= "Completed" then
            if not currentDifficulty then
                statusDisplay.Text = "Status: Detecting Difficulty..."
                running = false
                return
            end

            if currentDifficulty ~= expectedDifficulty then
                statusDisplay.Text = string.format(
                    "Status: Wrong Difficulty (%s / %s)",
                    currentDifficulty,
                    expectedDifficulty
                )
                running = false
                return
            end
        end
    end

    RouteProgressionByLevel(level, false)

    running = false
end

local AutoProgress = {}

function AutoProgress.Start()
    if AutoProgression then
        return true
    end

    AutoMaxMode = false
    Settings.AutoMaxProgression = false
    AutoProgression = true
    Settings.AutoProgression = true

    if (tonumber(Settings.RunStartedAt) or 0) <= 0 then
        Settings.RunStartedAt = os.time()
    end

    SaveSettings()
    UpdateToggleAppearance()

    task.spawn(RunAutoProgression)
    return true
end

function AutoProgress.StartAutoMax()
    if AutoProgression and AutoMaxMode then
        return true
    end

    AutoMaxMode = true
    Settings.AutoMaxProgression = true
    AutoProgressStrategy = "Lose"
    shared.AutoProgressStrategy = "Lose"

    AutoProgression = true
    Settings.AutoProgression = true

    if (tonumber(Settings.RunStartedAt) or 0) <= 0 then
        Settings.RunStartedAt = os.time()
    end

    SaveSettings()
    UpdateToggleAppearance()

    task.spawn(RunAutoProgression)
    return true
end

function AutoProgress.StopAutoMax()
    return AutoProgress.Stop()
end

function AutoProgress.IsAutoMax()
    return AutoMaxMode == true
end

function AutoProgress.Stop()
    AutoProgression = false
    Settings.AutoProgression = false
    AutoMaxMode = false
    Settings.AutoMaxProgression = false
    Settings.RunStartedAt = 0

    ResetMatchTimeout()

    running = false
    runningEasy = false
    runningMolten = false
    runningHardcore = false
    wrongDifficultyMatchmakingRunning = false

    SaveSettings()
    UpdateToggleAppearance()

    if IsInGame() then
        task.spawn(function()
            
            BackToLobby()
        end)
    end

    return true
end

function AutoProgress.SetStrategy(strategy)
    AutoProgressStrategy = strategy == "Lose" and "Lose" or "Win"
    shared.AutoProgressStrategy = AutoProgressStrategy
    
    return AutoProgressStrategy
end

function AutoProgress.GetStrategy()
    return AutoProgressStrategy
end

function AutoProgress.SetEnabled(state)
    if state then
        return AutoProgress.Start()
    end

    return AutoProgress.Stop()
end

function AutoProgress.IsEnabled()
    return AutoProgression == true
end

function AutoProgress.GetLevel()
    return tonumber(Settings.SavedLevel) or 0
end

function AutoProgress.GetStatus()
    if AutoMaxMode then
        return tostring(statusDisplay.Text or "Status: Auto Max")
    end

    if Settings.GatlingUnlocked == true then
        return "Gatling Unlocked"
    end

    return tostring(statusDisplay.Text or "Status: Disabled")
end



UpdateToggleAppearance()

local rewardGameOverHandled = false
local restartMatchLoopRunning = false

local function HandleRewardMilestone(currentMode, newLevel)
    newLevel = tonumber(newLevel) or 0

    if not AutoProgression then
        return false
    end

    if IsWinStrategy() then
        statusDisplay.Text = "Status: Returning to Lobby..."
        BackToLobby()
        return true
    end

    if currentMode == "Hardcore" and newLevel >= 175 then
        return RouteProgressionByLevel(newLevel, true)
    end

    if currentMode == "Molten" and newLevel >= 50 then
        statusDisplay.Text = "Status: Returning to Lobby..."
        BackToLobby()
        return true
    end

    if currentMode == "Easy" and newLevel >= 15 then
        statusDisplay.Text = "Status: Returning to Lobby..."
        BackToLobby()
        return true
    end

    return false
end

local function RestartMatchAndRerunStrategy()
    if restartMatchLoopRunning or not AutoProgression then
        return false
    end

    if not IsInGame() or GetStoryMissionName() then
        return false
    end

    local stateReplicators =
        ReplicatedStorage:FindFirstChild("StateReplicators")

    local rep =
        stateReplicators
        and stateReplicators:FindFirstChild("GameStateReplicator")

    if not rep then
        return false
    end

    repeat
        if not AutoProgression then
            return false
        end

        task.wait(0.1)
    until rep:GetAttribute("GameOver") == true

    restartMatchLoopRunning = true

    if IsWinStrategy() then
        local health = tonumber(rep:GetAttribute("Health")) or 0

        if health <= 0 then
            statusDisplay.Text = "Status: Lost - Returning to Lobby..."
            restartMatchLoopRunning = false
            BackToLobby()
            return true
        end
    end

    if IsWinStrategy()
        and tostring(Globals.PrivateCode or "") ~= "" then

        statusDisplay.Text = "Status: Returning to Private Lobby..."

        local launched = ReturnToPrivateLobby()

        if not launched then
            warn("[PRIVATE SERVER] Private return failed, falling back to normal lobby")
            BackToLobby()
        end

        restartMatchLoopRunning = false
        return true
    end

    statusDisplay.Text = IsWinStrategy() and "Status: Rematching..." or "Status: Restarting Match..."

    local restarted, restartResult = pcall(function()
        if IsWinStrategy() then
            local rematchEvent = ReplicatedStorage
                :WaitForChild("Network")
                :WaitForChild("GameManager")
                :WaitForChild("RE:Rematch")

            rematchEvent:FireServer()
            return true
        end

        return ReplicatedStorage
            :WaitForChild("RemoteFunction")
            :InvokeServer(
                "Voting",
                "Skip"
            )
    end)

    if not restarted then
        warn(IsWinStrategy() and "Failed to rematch:" or "Failed to restart match:", restartResult)
        statusDisplay.Text = "Status: Restart Failed"
        restartMatchLoopRunning = false
        return false
    end

    local timeoutAt = os.clock() + 45

    repeat
        if not AutoProgression then
            restartMatchLoopRunning = false
            return false
        end

        task.wait(0.1)
    until rep:GetAttribute("GameOver") == false
        or os.clock() >= timeoutAt

    if rep:GetAttribute("GameOver") ~= false then
        statusDisplay.Text = "Status: Restart Timed Out"
        restartMatchLoopRunning = false
        return false
    end

    task.wait(2)

    StartMatchTimeout()

    task.spawn(function()
        task.wait(60)

        if not AutoProgression then
            return
        end

        local ownedTowers = DirectGetOwnedTowers()

        if next(ownedTowers) == nil then
            warn("[ANTI STUCK] No tower placed after restart, rejoining...")

            pcall(function()
                TeleportService:Teleport(
                    game.PlaceId,
                    plr
                )
            end)
        end
    end)

    TDS:ResetIndex()

    running = false
    runningEasy = false
    runningMolten = false
    runningHardcore = false

    if not CurrentStrategyRunner then
        warn("[AUTO RESTART] No saved strategy runner")
        statusDisplay.Text = "Status: No Strategy To Re-run"
        restartMatchLoopRunning = false
        return false
    end

    statusDisplay.Text =
        "Status: Re-running "
        .. tostring(CurrentStrategyName or "Strategy")

    restartMatchLoopRunning = false

    task.spawn(function()
        

        local ok, result = pcall(CurrentStrategyRunner)

        if not ok then
            warn("[AUTO RESTART] Strategy error:", result)
        elseif result == false then
            warn("[AUTO RESTART] Strategy returned false")
        end
    end)

    return true
end

task.spawn(function()
    while true do
        task.wait(0.1)

        if IsInGame() then
            local stateReplicators =
                ReplicatedStorage:FindFirstChild("StateReplicators")

            local rep =
                stateReplicators
                and stateReplicators:FindFirstChild("GameStateReplicator")

            local isGameOver =
                rep and rep:GetAttribute("GameOver") == true

            if not isGameOver then
                rewardGameOverHandled = false
            elseif not rewardGameOverHandled then
                rewardGameOverHandled = true
                ResetMatchTimeout()
                

                local storyMission = GetStoryMissionName()

                if not storyMission then
                    UpdateTrackedCoinsFromReward()
                end

                if not storyMission and AutoProgression then
                    local oldLevel =
                        tonumber(Settings.SavedLevel) or 0

                    local captured, rewardLevel =
                        CaptureRewardLevel()

                    if captured and AutoProgression then
                        rewardLevel = tonumber(rewardLevel) or oldLevel

                        local currentMode = GetCurrentDifficulty()
                        local currentTarget

                        if IsWinStrategy() then
                            currentTarget = GetTargetLevel(oldLevel)
                        elseif currentMode == "Easy" then
                            currentTarget = 15
                        elseif currentMode == "Molten" then
                            currentTarget = 50
                        elseif currentMode == "Hardcore" then
                            currentTarget = 175
                        else
                            currentTarget = GetTargetLevel(oldLevel)
                        end

                        if rewardLevel >= 175 and AutoMaxMode then
                            task.spawn(function()
                                task.wait(0.5)
                                statusDisplay.Text = "Status: Returning to Lobby to Check Auto Max..."
                                BackToLobby()
                            end)
                        elseif rewardLevel >= 175 then
                            local trackedCoins = GetTrackedCoins()

                            if trackedCoins >= GATLING_PRICE then
                                task.spawn(function()
                                    task.wait(0.5)
                                    statusDisplay.Text = "Status: Returning to Lobby for Gatling..."
                                    BackToLobby()
                                end)
                            elseif currentMode == "Hardcore" then
                                task.spawn(function()
                                    task.wait(0.5)
                                    RouteProgressionByLevel(
                                        rewardLevel,
                                        true
                                    )
                                end)
                            else
                                task.spawn(function()
                                    task.wait(0.5)
                                    RestartMatchAndRerunStrategy()
                                end)
                            end
                        else
                            local reachedTarget =
                                currentTarget ~= nil
                                and rewardLevel >= currentTarget

                            if reachedTarget then
                                task.spawn(function()
                                    task.wait(0.5)
                                    HandleRewardMilestone(
                                        currentMode,
                                        rewardLevel
                                    )
                                end)
                            else
                                task.spawn(function()
                                    task.wait(0.5)
                                    RestartMatchAndRerunStrategy()
                                end)
                            end
                        end
                    else
                        statusDisplay.Text = "Status: Failed to read reward level"
                    end
                end
            end
        else
            rewardGameOverHandled = false
            restartMatchLoopRunning = false
            wrongDifficultyMatchmakingRunning = false
        end
    end
end)

