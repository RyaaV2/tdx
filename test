local function SaveSettings()
    if not writefile then
        return
    end

    local data = {}

    if isfile and readfile and isfile(SETTINGS_FILE) then
        pcall(function()
            local existing = HttpService:JSONDecode(readfile(SETTINGS_FILE))
            if type(existing) == "table" then
                data = existing
            end
        end)
    end

    for key, value in pairs(Settings) do
        data[key] = value
    end

    pcall(function()
        writefile(
            SETTINGS_FILE,
            HttpService:JSONEncode(data)
        )
    end)
end

local function FormatRunningTime()
    local startedAt = tonumber(Settings.RunStartedAt) or 0

    if startedAt <= 0 then
        return "00:00:00"
    end

    local totalSeconds = math.max(os.time() - startedAt, 0)

    local hours = math.floor(totalSeconds / 3600)
    local minutes = math.floor((totalSeconds % 3600) / 60)
    local seconds = totalSeconds % 60

    return string.format("%02d:%02d:%02d", hours, minutes, seconds)
end

