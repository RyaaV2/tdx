local function ReturnToPrivateLobby()
    local privateCode = tostring(Globals.PrivateCode or "")

    if privateCode == "" then
        return false
    end

    local platform = UIS:GetPlatform()
    local isMobile =
        platform == Enum.Platform.IOS
        or platform == Enum.Platform.Android

    if isMobile then
        return false
    end

    local ok, err = pcall(function()
        game:GetService("ExperienceService"):LaunchExperience({
            placeId = LOBBY_PLACE_ID,
            linkCode = privateCode
        })
    end)

    if not ok then
        warn("[PRIVATE SERVER] Failed to return to private lobby:", err)
        return false
    end

    return true
end

